<?xml version="1.0" encoding="utf-8"?>
<!-- Lets users pick the app's language in system Settings (Android 13+), and lets the AppCompat
     backport do the same below 13. Keep in sync with the values-* resource folders. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="zh-CN" />
    <locale android:name="zh-TW" />
</locale-config>
