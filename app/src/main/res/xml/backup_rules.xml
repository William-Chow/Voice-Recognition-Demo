<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below. Voice search queries are the user's own words and can be sensitive, so
  the DataStore file that holds the history is kept off Google's backup servers. Losing it costs
  nothing: the app is fully usable with an empty history.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/voice_search.preferences_pb" />
</full-backup-content>
