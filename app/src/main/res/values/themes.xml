<resources>
    <!--
      Material 3 (was the Material Components template) and NoActionBar: the Compose UI draws its
      own CenterAlignedTopAppBar, so the AppCompat action bar the old parent brought in is a second
      title bar the design never asked for.
    -->
    <style name="Theme.Voice" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_on_secondary</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/on_surface_light</item>
        <item name="android:colorBackground">@color/surface_light</item>
        <!-- What the system paints between tapping the icon and the first Compose frame. -->
        <item name="android:windowBackground">@color/surface_light</item>
    </style>

    <!--
      Applied from the manifest and swapped for Theme.Voice by installSplashScreen().
      Deliberately brand-coloured rather than dynamic: the splash should read as this app,
      and the Material You palette takes over the moment the UI appears.
    -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/surface_light</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Voice</item>
    </style>
</resources>
